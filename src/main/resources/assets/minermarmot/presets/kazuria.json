{
    "name": "Kazuria",
    "autoBoostBlockUpward": false,
    "features": {
        "autoMine": true,
        "autoSprint": true,
        "autoBoost": true,
        "autoCameraLock": true,
        "autoCenterBlock": true,
        "autoFlightHeight": true,
        "obstacleMiner": true,
        "worldBorder": true,
        "placementWithoutDelay": true
    },
    "defaults": {
        "enabled": [
            "autoMine",
            "autoSprint",
            "autoCameraLock",
            "autoCenterBlock",
            "obstacleMiner"
        ],
        "worldBorderDistance": 0
    },
    "tnt": {
        "builder": true,
        "carpet": true,
        "builderWandName": "Baguette du bâtisseur",
        "shulkerItem": "minecraft:red_shulker_box",
        "shopClicks": [
            "minecraft:red_shulker_box"
        ]
    },
    "playerAlerts": {
        "inventoryFull": true,
        "privateMessage": true,
        "privateMessagePattern": "^\\[[^\\]]+ -> Moi\\]",
        "defaults": {
            "inventoryFull": true,
            "inventoryFullSound": "minecraft:block.note_block.pling",
            "inventoryFullVolume": 1.0,
            "inventoryFullRepeat": 3,
            "privateMessage": true,
            "privateMessageSound": "minecraft:block.note_block.pling",
            "privateMessageVolume": 1.0,
            "privateMessageRepeat": 3
        }
    },
    "portals": {
        "defaults": {
            "displayedWaypointCount": 3,
            "waypointDisplayDistance": 256
