{
    "name": "Minerite",
    "features": {
        "autoMine": true,
        "dolphin": true,
        "autoSprint": true,
        "autoBoost": true,
        "autoCameraLock": true,
        "autoCenterBlock": true,
        "autoFlightHeight": true,
        "obstacleMiner": true,
        "worldBorder": true,
        "placementWithoutDelay": true
    },
    "defaults": {
        "enabled": [
            "autoMine",
            "autoSprint",
            "autoCameraLock",
            "autoCenterBlock",
            "obstacleMiner"
        ],
        "worldBorderDistance": 0,
        "autoBoostIntervalMs": 200,
        "dolphinMinY": 10,
        "dolphinMaxY": 230,
        "dolphinAdvanceBlocks": 5
    },
    "tnt": {
        "builder": false,
        "carpet": true,
        "builderWandName": "",
        "shulkerItem": "minecraft:red_shulker_box",
        "shopClicks": [
            "minecraft:red_shulker_box",
            "minecraft:lime_stained_glass_pane"
        ]
    },
    "playerAlerts": {
        "inventoryFull": true,
        "privateMessage": true,
        "privateMessagePattern": "^\\[[^\\]]+ → toi\\]",
        "defaults": {
            "inventoryFull": true,
            "inventoryFullSound": "minecraft:block.note_block.bell",
            "inventoryFullVolume": 1.0,
            "inventoryFullRepeat": 1,
            "privateMessage": true,
            "privateMessageSound": "minecraft:block.note_block.pling",
            "privateMessageVolume": 1.0,
            "privateMessageRepeat": 1
        }
    }
